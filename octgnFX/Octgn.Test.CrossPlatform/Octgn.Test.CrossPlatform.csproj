<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the libraries on .NET 10 (macOS, Linux, Windows). They run with NUnitLite:
    "dotnet run" in this folder (NUnitLite options after a lone double dash).
    The library tests of Octgn.Test that do not need the WPF engine are compiled here too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Octgn.Test</RootNamespace>
    <AssemblyName>Octgn.Test.CrossPlatform</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Octgn.Test\Library\ConfigFileSaveTests.cs" Link="Shared\Library\ConfigFileSaveTests.cs" />
    <Compile Include="..\Octgn.Test\Library\XFileOpenTests.cs" Link="Shared\Library\XFileOpenTests.cs" />
    <Compile Include="..\Octgn.Test\Library\Networking\GameBroadcastingTests.cs" Link="Shared\Library\Networking\GameBroadcastingTests.cs" />
    <Compile Include="..\Octgn.Test\Server\GameStatusResetTests.cs" Link="Shared\Server\GameStatusResetTests.cs" />
    <Compile Include="..\Octgn.Test\Server\HostedGameProcessTests.cs" Link="Shared\Server\HostedGameProcessTests.cs" />
    <Compile Include="..\Octgn.Test\Server\ServerPortReuseTests.cs" Link="Shared\Server\ServerPortReuseTests.cs" />
    <Compile Include="..\Octgn.Test\Server\ServerHelloRaceTests.cs" Link="Shared\Server\ServerHelloRaceTests.cs" />
    <Compile Include="..\Octgn.Test\Server\ServerShutdownTests.cs" Link="Shared\Server\ServerShutdownTests.cs" />
    <Compile Include="..\Octgn.Test\PlayGround.cs" Link="Shared\PlayGround.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Compat\JavaScriptSerializerTests.cs" />
    <Compile Include="Core\ColorTests.cs" />
    <Compile Include="Core\PackageRepositoryTests.cs" />
    <Compile Include="Engine\GameEngineTests.cs" />
    <Compile Include="Engine\GamePackageTests.cs" />
    <Compile Include="Engine\TestPackages.cs" />
    <Compile Include="Library\HostedGameBroadcastSerializerTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestData\HostedGame.BinaryFormatter.bin" LogicalName="HostedGame.BinaryFormatter.bin" />
  </ItemGroup>
  <ItemGroup>
    <!-- Game template of Octgn.GameStudio (git submodule), made loadable as in the headless check. -->
    <Compile Include="..\Octgn.Headless\SampleGame.cs" Link="Engine\SampleGame.cs" />
    <None Include="..\Octgn.GameStudio\Resources\Templates\Basic-Game\Game Plugin\**\*" Link="SampleGame\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Octgn.Compat.SystemWebExtensions\Octgn.Compat.SystemWebExtensions.csproj" />
    <ProjectReference Include="..\Octgn.Communication\Octgn.Communication\Octgn.Communication.csproj" />
    <ProjectReference Include="..\Octgn.Core\Octgn.Core.csproj" />
    <ProjectReference Include="..\Octgn.DataNew\Octgn.DataNew.csproj" />
    <ProjectReference Include="..\Octgn.Library\Octgn.Library.csproj" />
    <ProjectReference Include="..\Octgn.Online\Octgn.Online.csproj" />
    <ProjectReference Include="..\Octgn.Server\Octgn.Server.csproj" />
    <ProjectReference Include="..\Octgn.Engine\Octgn.Engine.csproj" />
    <!-- Built first; the engine tests start it from its own output folder (HostedGameProcess, debug lookup). -->
    <ProjectReference Include="..\Octgn.Online.StandAloneServer\Octgn.Online.StandAloneServer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnitLite" Version="3.13.3" />
  </ItemGroup>
</Project>
