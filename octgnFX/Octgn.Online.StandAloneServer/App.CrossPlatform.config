<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration of the .NET 10 build (macOS, Linux). Same settings as App.config, without the
     .NET Framework sections and without the Windows event log appender. -->
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <appSettings>
    <add key="log4net.Internal.Debug" value="false" />
    <add key="SiteApiKey" value="##SITEAPIKEY##" />
    <add key="WaitForKeyOnExit" value="false" />
    <add key="PlayerTimeoutSeconds" value="12" />
  </appSettings>
  <log4net>
    <root>
      <!-- Levels: 1=OFF,2=FATAL,3=ERROR,4=WARN,5=INFO,6=DEBUG,7ALL -->
      <level value="ALL" />
      <appender-ref ref="ConsoleAppender" />
    </root>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %level %logger - %message%newline %exception" />
      </layout>
    </appender>
  </log4net>
</configuration>
