<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the Avalonia table (Octgn.Desktop) without a screen: Avalonia's headless platform with Skia
    rendering, a local game of the Basic-Game template, simulated mouse input, and pictures of the
    window (PNG files in the folder given by OCTGN_SCREENSHOTS, or the output folder).
    Run "dotnet run -c Release" in this folder (NUnitLite options after a lone double dash).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Octgn.Desktop.Test</RootNamespace>
    <AssemblyName>Octgn.Desktop.Test</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="UiFixture.cs" />
    <Compile Include="TableTests.cs" />
    <Compile Include="MarvelChampionsTests.cs" />
    <!-- Game template of Octgn.GameStudio (git submodule), made loadable as in the headless check. -->
    <Compile Include="..\Octgn.Headless\SampleGame.cs" Link="SampleGame.cs" />
    <None Include="..\Octgn.GameStudio\Resources\Templates\Basic-Game\Game Plugin\**\*" Link="SampleGame\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Octgn.Desktop\Octgn.Desktop.csproj" />
    <ProjectReference Include="..\Octgn.Online.StandAloneServer\Octgn.Online.StandAloneServer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnitLite" Version="3.13.3" />
  </ItemGroup>
</Project>
